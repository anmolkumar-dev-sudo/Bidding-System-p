# Copy the needed settings into server/.env and replace placeholder values.
MONGO_URI=mongodb://127.0.0.1:27017/bidding_app
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500/client/index.html
MONGODB_SEARCH_INDEX=listing_autocomplete
REDIS_URL=redis://127.0.0.1:6379
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bidroom/listings
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM="Bidroom <no-reply@your-verified-domain.com>"
ADMIN_EMAIL=

